<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>روابطنا | طهطا وشبابها</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  min-height:100vh;font-family:Arial,Tahoma,sans-serif;
  background:linear-gradient(145deg,#eef4ff,#f7f8fc);
  display:flex;align-items:center;justify-content:center;padding:24px;
}
.card{
  width:100%;max-width:430px;background:#fff;border-radius:28px;
  padding:30px 20px 22px;text-align:center;
  box-shadow:0 18px 50px rgba(20,40,80,.13);
}
.logo{
  width:92px;height:92px;margin:0 auto 16px;border-radius:50%;
  background:linear-gradient(135deg,#1877f2,#25d366);
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:40px;font-weight:bold;
  box-shadow:0 10px 25px rgba(24,119,242,.2);
}
h1{font-size:26px;color:#182033;margin-bottom:7px}
.sub{color:#727989;font-size:14px;margin-bottom:25px}
.links{display:grid;gap:14px}
.link{
  min-height:70px;border-radius:18px;color:#fff;text-decoration:none;
  display:flex;align-items:center;padding:10px 14px;
  box-shadow:0 8px 20px rgba(0,0,0,.1);
  transition:.2s transform,.2s box-shadow;
}
.link:hover{transform:translateY(-2px);box-shadow:0 11px 24px rgba(0,0,0,.14)}
.link:active{transform:scale(.98)}
.icon{
  width:48px;height:48px;border-radius:14px;
  background:rgba(255,255,255,.2);
  display:flex;align-items:center;justify-content:center;
  font-size:25px;font-weight:bold;flex:none;
}
.name{flex:1;font-size:15px;font-weight:700;line-height:1.45;padding:0 10px}
.arrow{font-size:22px;opacity:.85}
.facebook{background:#1877f2}
.whatsapp{background:#25d366}
.youtube{background:#ff0000}
.website{background:#34495e}
footer{margin-top:22px;color:#9aa1ad;font-size:11px}
</style>
</head>
<body>
<div class="card">
  <div class="logo">🔗</div>
  <h1>روابطنا</h1>
  <p class="sub">تابعنا وانضم إلى قنواتنا</p>

  <div class="links">

    <a class="link facebook"
       href="https://www.facebook.com/share/19rjS2WVfZ/"
       target="_blank" rel="noopener noreferrer">
      <div class="icon">f</div>
      <div class="name">Facebook</div>
      <div class="arrow">←</div>
    </a>

    <a class="link whatsapp"
       href="https://whatsapp.com/channel/0029Vb91miN6LwHhRMx1Aj0B"
       target="_blank" rel="noopener noreferrer">
      <div class="icon">◉</div>
      <div class="name">فريق تاجرو - اللاهوت الدفاعي<br>طهطا و جهينة</div>
      <div class="arrow">←</div>
    </a>

    <a class="link whatsapp"
       href="https://whatsapp.com/channel/0029VafBxt5CcW4zRN6Nbw1E"
       target="_blank" rel="noopener noreferrer">
      <div class="icon">◉</div>
      <div class="name">خدمة الشباب بمطرانية طهطا و جهينة<br>وتوابعهما</div>
      <div class="arrow">←</div>
    </a>

    <a class="link youtube"
       href="https://youtube.com/@tahtasyouth?si=TdeM8hN_mg5Qm0zF"
       target="_blank" rel="noopener noreferrer">
      <div class="icon">▶</div>
      <div class="name">YouTube - Tahta Youth</div>
      <div class="arrow">←</div>
    </a>

    <a class="link website"
       href="https://tg-chys.com/"
       target="_blank" rel="noopener noreferrer">
      <div class="icon">🌐</div>
      <div class="name">الموقع الإلكتروني</div>
      <div class="arrow">←</div>
    </a>

  </div>

  <footer>جميع الروابط الرسمية</footer>
</div>
</body>
</html>